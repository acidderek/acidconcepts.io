ublisher:{"@type":"Organization","@id":`${kn}/#organization`,name:"Acid Concepts",logo:{"@type":"ImageObject",url:`${kn}/logo-symbol.svg`}},productionCompany:{"@id":`${kn}/#organization`},inLanguage:"en-US",isFamilyFriendly:!0,genre:["Interactive Technology","Digital Installation","Immersive Experience"],keywords:"interactive installation, immersive experience, digital experience, interactive technology",potentialAction:{"@type":"WatchAction",target:`${kn}/project/${e.slug}`}}:null,kqe=()=>[{"@context":"https://schema.org","@type":"SoftwareApplication","@id":`${kn}/#app-elevenhype`,name:"ElevenHype",alternateName:"11Hype",description:"Next-generation sports fan engagement platform featuring gamification, interactive experiences, and real-time fan activations for sports teams and entertainment venues.",url:"https://elevenhype.com",applicationCategory:"SportsApplication",operatingSystem:"Web, iOS, Android",offers:{"@type":"Offer",price:"0",priceCurrency:"USD",description:"Contact for enterprise pricing"},author:{"@id":`${kn}/#organization`},creator:{"@id":`${kn}/#organization`},featureList:["Fan gamification and rewards","Real-time interactive experiences","Sports venue activations","Social engagement tools","Analytics dashboard"],screenshot:`${kn}/og-default.jpg`,softwareVersion:"2.0",datePublished:"2023-01-01",aggregateRating:{"@type":"AggregateRating",ratingValue:"4.8",ratingCount:"150",bestRating:"5",worstRating:"1"}},{"@context":"https://schema.org","@type":"SoftwareApplication","@id":`${kn}/#app-acidvault`,name:"Acid Vault",alternateName:"The Vault by Acid",description:"Enterprise-grade digital asset management and content delivery platform for interactive installations and immersive experiences. Secure, scalable, and designed for high-performance media delivery.",url:"https://acidvault.cloud",applicationCategory:"BusinessApplication",operatingSystem:"Web, Windows, macOS",offers:{"@type":"Offer",price:"0",priceCurrency:"USD",description:"Enterprise licensing ava