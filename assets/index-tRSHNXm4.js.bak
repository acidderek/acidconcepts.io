 Walls":us,"Custom Games":sm,"Immersive Spaces":Ml,"Hall of Fame Displays":J2},DJe={"Interactive Walls":NI,"Video Walls & Digital Signage":Tue,"Donor Recognition Walls":Iue,"Custom Games":PJ,"Immersive Spaces":EJ,"Hall of Fame Displays":Nue},die={"interactive-walls":{title:"Interactive Walls",description:"Engage audiences with wall projection, touch screens, and motion sensors. Perfect for events, public spaces, and presentations.",longDescription:"Transform any wall into an immersive interactive canvas. Our interactive wall solutions combine cutting-edge projection mapping, responsive touch technology, and intelligent motion sensing to create memorable experiences that captivate audiences and encourage participation.",features:["Multi-touch capability supporting up to 100 simultaneous touch points","Gesture recognition and motion tracking","High-resolution projection mapping","Custom software development for unique interactions","Real-time content management systems"],benefits:["Increase visitor engagement by up to 300%","Create memorable brand experiences","Collect valuable interaction data","Easy content updates via CMS","Scalable to any wall size"],color:"from-cyan-500 to-blue-500"},"video-walls-digital-signage":{title:"Video Walls & Digital Signage",description:"Large-scale LED and LCD video walls with customized software and powerful content management systems.",longDescription:"Deliver stunning visual impact with our professional video wall and digital signage solutions. From seamless LED displays to precision-aligned LCD arrays, we design and install systems that command attention and communicate your message with clarity.",features:["LED, LCD, and OLED panel options","Seamless bezel-free configurations","4K and 8K resolution support","Cloud-based content management","Multi-zone content scheduling"],benefits:["Maximum visual impact in any environment","24/7 reliable operation","Remote content updates","Energy-efficient solutions","Flexible sizing and configurations"],color:"from-purple-500 to-pink-500"},"donor-recognition-walls":{title:"Donor Recognition Walls",description:"Tell your organization's story and mission while thanking donors for their generosity with stunning digital displays.",longDescription:"Honor your donors with elegant digital recognition walls that tell compelling stories. Our solutions go beyond static plaques to create living tributes that can be updated in real-time, celebrating generosity while inspiring future giving.",features:["Dynamic donor listings with real-time updates","Interactive storytelling elements","Multi-media integration (photos, videos, audio)","Touch-enabled donor exploration","Automated campaign milestone celebrations"],benefits:["Strengthen donor relationships","Inspire new contributions","Reduce ongoing recognition costs","Easy updates for new donors","Showcase impact and mission"],color:"from-emerald-500 to-teal-500"},"custom-games":{title:"Custom Games",description:"Touch, gesture, and body motion interactive games combining avatars, AR/VR, and state-of-the-art AI tools.",longDescription:"Create unforgettable entertainment experiences with custom-designed interactive games. Our team develops engaging games that utilize the latest in touch, gesture, AR/VR, and AI technologies to create immersive experiences for all ages.",features:["Full-body motion tracking games","AR and VR experiences","AI-powered adaptive difficulty","Custom avatar creation","Multiplayer and competitive modes"],benefits:["Unique branded entertainment","Increased visitor dwell time","Memorable shareable moments","Educational gaming options","Scalable for any audience size"],color:"from-orange-500 to-red-500"},"immersive-spaces":{title:"Immersive Spaces",description:"Transform entire rooms into captivating experiences that wow visitors and create lasting memories.",longDescription:"Step into another world with our fully immersive environment solutions. We transform entire spaces into 360-degree experiences using synchronized projection, spatial audio, and interactive elements that transport visitors to new realities.",features:["360-degree projection mapping","Spatial audio integration","Floor and ceiling projections","Interactive environmental controls","Themed experience design"],benefits:["Complete sensory immersion","Unforgettable visitor experiences","Versatile for multiple themes","Premium attraction potential","Social media-worthy moments"],color:"from-violet-500 to-purple-500"},"hall-of-fame-displays":{title:"Hall of Fame Displays",description:"Honor students, employees, and athletes with interactive digital recognition walls that celebrate achievements.",longDescription:"Celebrate excellence with dynamic hall of fame displays that bring achievements to life. Our interactive recognition walls showcase accomplishments through rich media, detailed profiles, and engaging exploration tools that honor past achievements while inspiring future success.",features:["Rich media profiles (video, photos, stats)","Interactive timeline exploration","Search and filter capabilities","Achievement categories and sorting","Integration with records systems"],benefits:["Preserve institutional legacy","Inspire current members","Easy annual updates","Space-efficient recognition","Engaging visitor experience"],color:"from-amber-500 to-orange-500"}},uie=e=>e.toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/(^-|-$)/g,""),_ve=()=>{const{slug:e}=xJ();cf();const{getArray:t,loading:n}=af("services");E.useEffect(()=>{window.scrollTo(0,0)},[e]);const i=t("services",[]),o=e||"",d=i.find(R=>uie(R.title)===o),h=die[o];let a=null;if(d){const R=h||Object.values(die).find(N=>uie(N.title)===o);a={title:d.title,description:d.description,longDescription:d.longDescription||d.backDescription||(R==null?void 0:R.longDescription)||d.description,features:d.features&&d.features.length>0?d.features:(R==null?void 0:R.features)||[],benefits:d.benefits&&d.benefits.length>0?d.benefits:(R==null?void 0:R.benefi